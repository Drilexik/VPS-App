[Unit]
Description=Drilex VPS Manager Backend
Documentation=https://github.com/your/drilex
After=network.target

[Service]
Type=simple
# root – nutné pro file manager (mkdir/edit v /home, /etc/nginx atd.) a iptables.
# Zabezpečení: API key + HTTPS + nginx rate limiting.
User=root
Group=root
WorkingDirectory=/opt/drilex-backend
EnvironmentFile=/opt/drilex-backend/.env
ExecStart=/opt/drilex-backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal
SyslogIdentifier=drilex

# Rychlý stop – jinak SSE spojení blokují shutdown.
# KillMode=mixed: main proces SIGINT, children SIGKILL.
# TimeoutStopSec=5: po 5 s pošli SIGKILL všem.
KillMode=mixed
KillSignal=SIGINT
TimeoutStopSec=5

# Lehké hardening (běží jako root, takže nepotřebujeme capabilities)
NoNewPrivileges=false
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
